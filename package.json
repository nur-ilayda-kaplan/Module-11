{
  "name": "module-11",
  "version": "1.0.0",
  "private": true,
  "description": "Module-11 QA automation repository with WebdriverIO, Cucumber, ESLint, and Prettier.",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=@smoke",
    "test:chrome": "cross-env BROWSER=chrome wdio run ./wdio.conf.js",
    "test:firefox": "cross-env BROWSER=firefox wdio run ./wdio.conf.js",
    "test:safari": "cross-env BROWSER=safari wdio run ./wdio.conf.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "devDependencies": {
    "@wdio/cli": "^9.27.0",
    "@wdio/cucumber-framework": "^9.27.0",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.0",
    "chai": "^6.2.2",
    "chromedriver": "latest",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "expect-webdriverio": "latest",
    "prettier": "^2.8.8",
    "webdriverio": "^9.27.0"
  },
  "main": "wdio.conf.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nur-ilayda-kaplan/Module-5.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nur-ilayda-kaplan/Module-5/issues"
  },
  "homepage": "https://github.com/nur-ilayda-kaplan/Module-5#readme"
}
